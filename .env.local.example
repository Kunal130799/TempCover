# Copy this file to .env.local and fill in your values.

# Stripe test-mode secret key. https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here

# Vehicle data API key from https://checkcardetails.co.uk (server-side only —
# never expose this to the client or commit it).
VEHICLE_API_KEY=your_checkcardetails_api_key

# Resend API key for sending the certificate email. https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sending address (or Resend's onboarding@resend.dev for testing).
RESEND_FROM_EMAIL=TempDrive Demo <onboarding@resend.dev>
